<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Contact tag defining who is copied on alert emails. The alert itself is
        addressed to the exploitation manager of the country concerned (see
        quality_alert._notify_alerte); contacts tagged "Responsable Qualite
        FutureKawa" receive a copy so the quality department keeps oversight.
        Tag or untag a Contact in the Contacts app to change the list. No
        addresses are stored in source.
    -->
    <record id="partner_category_responsable_qualite" model="res.partner.category">
        <field name="name">Responsable Qualite FutureKawa</field>
        <field name="color">1</field>
    </record>
</odoo>
