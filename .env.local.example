# Environnement d'une stack pays (docker-compose.local.yml). Un fichier par pays.
# cp .env.local.example .env.local
# docker compose --env-file .env.local -f docker-compose.local.yml up -d --build
#
# Uniquement ce qui change par pays et les secrets. Le câblage réseau
# (POSTGRES_HOST, POSTGRES_PORT, MQTT_BROKER_URL) est fixé dans le Compose.

# ── Identité du pays ────────────────────────────────────────────────────────
# Le code doit correspondre à celui déclaré dans FUTUREKAWA_LOCALS au siège.
COUNTRY_CODE=BR
COUNTRY_NAME=Brésil

# ── Conditions de stockage idéales ──────────────────────────────────────────
TEMPERATURE_IDEALE_C=29
HUMIDITE_IDEALE_POURCENT=55

# ── Tolérances (au-delà, une alerte est levée) ──────────────────────────────
TOLERANCE_TEMPERATURE_C=3
TOLERANCE_HUMIDITE_POURCENT=2

# ── Péremption des lots ─────────────────────────────────────────────────────
DUREE_MAX_STOCKAGE_JOURS=365

# ── MQTT (l'URL du broker est câblée dans le Compose) ───────────────────────
MQTT_TOPIC=futurekawa/${COUNTRY_CODE}/entrepot/+/mesures
MQTT_CLIENT_ID=backend-local-${COUNTRY_CODE}
MQTT_QOS=1

# ── PostgreSQL (hôte et port câblés dans le Compose) ────────────────────────
POSTGRES_DB=futurekawa
POSTGRES_USER=futurekawa
# Obligatoire : Compose refuse de démarrer sans.
POSTGRES_PASSWORD=change-me-in-prod

# ── Odoo (dans la stack siège : adresse joignable, pas un nom de conteneur) ─
ODOO_URL=http://odoo.futurekawa.internal:8069
ODOO_DB=futurekawa
ODOO_API_USER=api-backend@futurekawa.local
ODOO_API_KEY=change-me-odoo-api-key

# ── Serveur ─────────────────────────────────────────────────────────────────
SERVER_PORT=8081

# ── Données de référence ────────────────────────────────────────────────────
# Amorçage idempotent du Pays, des exploitations et des entrepôts au démarrage.
# Sans Pays, /api/v1/pays ne répond pas ; sans entrepôt, aucune mesure n'entre.
SEED_REFERENCE_DATA=true

# ── Balayage des lots périmés ───────────────────────────────────────────────
# Cron Spring. Par défaut à l'heure ronde ; ne le resserrer que pour démontrer.
PEREMPTION_CRON=0 0 * * * *
