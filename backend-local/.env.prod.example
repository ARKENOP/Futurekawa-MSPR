# ==============================================================================
# FutureKawa Backend Local — PRODUCTION .env template (one country per stack)
# ==============================================================================
# Copy to `.env` and edit per country:  cp .env.prod.example .env
#
# This file holds only what changes per country + secrets. Docker-network
# wiring (POSTGRES_HOST, POSTGRES_PORT, MQTT_BROKER_URL) is set in
# docker-compose.prod.yml — do NOT put it here.
# ==============================================================================

# ── Country identity ──────────────────────────────────────────────────────────
COUNTRY_CODE=BR
COUNTRY_NAME=Brésil

# ── Ideal storage conditions (per country's coffee beans) ──────────────────────
TEMPERATURE_IDEALE_C=29
HUMIDITE_IDEALE_POURCENT=55
TOLERANCE_TEMPERATURE_C=3
TOLERANCE_HUMIDITE_POURCENT=2

# ── Lot expiry ──────────────────────────────────────────────────────────────
DUREE_MAX_STOCKAGE_JOURS=365

# ── MQTT (broker URL is wired in compose; topic/client-id derive from country) ─
MQTT_TOPIC=futurekawa/${COUNTRY_CODE}/entrepot/+/mesures
MQTT_CLIENT_ID=backend-local-${COUNTRY_CODE}
MQTT_QOS=1

# ── PostgreSQL credentials (host/port are wired in compose) ────────────────────
POSTGRES_DB=futurekawa
POSTGRES_USER=futurekawa
# REQUIRED — compose refuses to start if unset. Use a strong value in prod.
POSTGRES_PASSWORD=change-me-in-prod

# ── Odoo (lives at the siège / backend-central — point at it or leave default) ─
ODOO_URL=http://siege-backend-central:8069
ODOO_DB=futurekawa
ODOO_API_USER=api-backend@futurekawa.local
ODOO_API_KEY=change-me-odoo-api-key

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8081
