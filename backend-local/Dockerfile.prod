# ==============================================================================
# FutureKawa Backend Local — PRODUCTION image (self-contained multi-stage)
# ==============================================================================
# Stage 1 builds the Spring Boot fat jar from source with Maven (JDK 25), so a
# fresh checkout deploys with `docker compose -f docker-compose.prod.yml up -d`
# and needs no host-side JDK/Maven.
# Stage 2 runs that jar on a lean JRE.
#
# IMPORTANT: the build context is the REPOSITORY ROOT, not backend-local/,
# because this service depends on the futurekawa-lib module. docker-compose.prod.yml
# sets `context: ..` + `dockerfile: backend-local/Dockerfile.prod` accordingly.
#
# Tests are skipped here: they run in CI (`mvn verify`), not on the deployment host.
# ==============================================================================

# ── Stage 1: build ───────────────────────────────────────────────────────────
FROM maven:3.9-eclipse-temurin-25 AS build
WORKDIR /build

# Resolve dependencies first so they cache across source-only changes. Every
# module pom is copied because the root aggregator declares all of them; `-pl … -am`
# then narrows the actual build to backend-local and the library it needs.
COPY pom.xml .
COPY futurekawa-lib/pom.xml futurekawa-lib/
COPY backend-local/pom.xml backend-local/
COPY backend-central/pom.xml backend-central/
RUN mvn -B -q -pl backend-local -am dependency:go-offline

COPY futurekawa-lib/src futurekawa-lib/src
COPY backend-local/src backend-local/src
RUN mvn -B -q -Dmaven.test.skip=true -pl backend-local -am clean package

# ── Stage 2: runtime ─────────────────────────────────────────────────────────
FROM eclipse-temurin:25-jre
WORKDIR /app

# curl is used by the compose healthcheck to poll the actuator endpoint.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Run as a non-root user in production.
RUN useradd -r -u 1001 -s /usr/sbin/nologin futurekawa
USER futurekawa

COPY --from=build /build/backend-local/target/backend-local-0.1.0-SNAPSHOT.jar /app/backend-local.jar

EXPOSE 8081
ENTRYPOINT ["java", "-jar", "/app/backend-local.jar"]
