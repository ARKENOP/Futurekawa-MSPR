# Base URL de l'API du backend central.
# En dev, laisser une URL relative : le proxy Vite (vite.config.ts) relaie
# /api/v1/** vers VITE_PROXY_TARGET, donc pas de CORS côté navigateur.
VITE_API_BASE_URL=/api/v1

# Cible du proxy Vite en dev = backend central.
VITE_PROXY_TARGET=http://localhost:8090

# true = MSW intercepte les appels et renvoie des fixtures (dev hors-ligne)
# false = appels réels vers le backend central
VITE_USE_MOCKS=false
