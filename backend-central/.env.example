# ==============================================================================
# FutureKawa MSPR — Backend Central Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and adjust the values for the target deployment.
# ==============================================================================

# ── Backends locaux (un par pays) ────────────────────────────────────────────
LOCAL_BR_URL=http://backend-local-br:8081
LOCAL_EC_URL=http://backend-local-ec:8081
LOCAL_CO_URL=http://backend-local-co:8081

# ── Découverte périodique des pays (GET /api/v1/pays) ────────────────────────
DISCOVERY_FIXED_DELAY_MS=60000

# ── Client HTTP vers les locaux ──────────────────────────────────────────────
LOCAL_CONNECT_TIMEOUT_MS=2000
LOCAL_READ_TIMEOUT_MS=5000

# ── Sécurité : Keycloak (OIDC / JWT) ─────────────────────────────────────────
KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/futurekawa

# ── Serveur ───────────────────────────────────────────────────────────────────
SERVER_PORT=8090
