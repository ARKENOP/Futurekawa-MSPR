# ==============================================================================
# FutureKawa MSPR — Backend Central Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and adjust the values for the target deployment.
# ==============================================================================

# ── Backend-local instances (one per country) ────────────────────────────────
LOCAL_BR_URL=http://backend-local-br:8081
LOCAL_EC_URL=http://backend-local-ec:8081
LOCAL_CO_URL=http://backend-local-co:8081

# ── Periodic country discovery (GET /api/v1/pays) ───────────────────────────
DISCOVERY_FIXED_DELAY_MS=60000

# ── HTTP client towards the locals ──────────────────────────────────────────
LOCAL_CONNECT_TIMEOUT_MS=2000
LOCAL_READ_TIMEOUT_MS=5000

# ── CORS: frontend origins allowed to call the central ──────────────────────
# No application-level authentication on the central: it is exposed on the
# headquarters' private network only. See docs/ARCHITECTURE.md.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Server ──────────────────────────────────────────────────────────────────
SERVER_PORT=8090
