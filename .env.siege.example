# Environnement de la stack siège (docker-compose.siege.yml).
# cp .env.siege.example .env.siege
# docker compose --env-file .env.siege -f docker-compose.siege.yml up -d --build

# ── Base de données Odoo ────────────────────────────────────────────────────
ODOO_DB_USER=odoo
# Obligatoire : Compose refuse de démarrer sans.
ODOO_DB_PASSWORD=change-me-in-prod

# ── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_PORT=8080

# ── Backends pays : une paire CODE=url par pays déployé ─────────────────────
# Liste ouverte, aucun code à modifier. Le code doit correspondre au
# COUNTRY_CODE déclaré dans le .env.local du pays. Ces stacks tournent sur
# d'autres hôtes : utiliser des adresses joignables, pas des noms de conteneurs.
FUTUREKAWA_LOCALS=BR=http://backend-local-br.futurekawa.internal:8081,EC=http://backend-local-ec.futurekawa.internal:8081,CO=http://backend-local-co.futurekawa.internal:8081

# ── Découverte périodique des pays (GET /api/v1/pays) ───────────────────────
DISCOVERY_FIXED_DELAY_MS=60000

# ── Client HTTP vers les pays ───────────────────────────────────────────────
LOCAL_CONNECT_TIMEOUT_MS=2000
LOCAL_READ_TIMEOUT_MS=5000

# ── CORS ────────────────────────────────────────────────────────────────────
# Le frontend conteneurisé passe par nginx, donc même origine : rien à déclarer
# ici pour lui. Ces entrées couvrent un serveur Vite lancé contre cette stack.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Serveur ─────────────────────────────────────────────────────────────────
SERVER_PORT=8090
